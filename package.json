{
  "name": "dy-live",
  "version": "0.1.6",
  "description": "抖音关注直播桌面观看工具（Electron）",
  "main": "./out/main/index.js",
  "author": "oduan",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:mac": "electron-vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "hls.js": "^1.5.13",
    "mpegts.js": "^1.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
